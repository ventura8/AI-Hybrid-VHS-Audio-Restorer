FROM python:3.12-slim AS base

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    POETRY_VERSION=2.4.1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_VIRTUALENVS_IN_PROJECT=false

WORKDIR /workspace

RUN pip install "poetry==${POETRY_VERSION}"

COPY pyproject.toml poetry.lock ./
RUN poetry install -v --only main,dev --without ml --no-root

COPY . .

FROM base AS markdown-lint
RUN find README.md AGENTS.md .agent .agents docs tests/README.md -type f -name '*.md' -print0 \
    | xargs -0 poetry run mdformat --check \
    && find README.md AGENTS.md .agent .agents docs tests/README.md -type f -name '*.md' -print0 \
    | xargs -0 poetry run pymarkdown --config .pymarkdown.json scan
