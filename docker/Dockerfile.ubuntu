FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    git \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.24@sha256:3af4716e991d6956a41e573eab705d0ee08500cd829ed30293eb8472f372c65a /uv /uvx /usr/local/bin/

WORKDIR /app
RUN chown -R ubuntu:ubuntu /app

USER ubuntu
COPY --chown=ubuntu:ubuntu . /app

RUN uv python install 3.12
RUN chmod +x install_dependencies.sh start.sh run_pipeline_locally.sh
RUN ./install_dependencies.sh
RUN .venv/bin/poetry install --with dev --no-root

CMD [".venv/bin/python", "-m", "pytest", "tests/", "-v"]
